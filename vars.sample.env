# PROVIDER
RELAYHOST="[smtps.example.com]:465"
RELAYHOST_USERNAME="relayhost-username@example.com"
RELAYHOST_PASSWORD="SUPER-SECRET-PASSWORD"
# SECURITY
POSTFIX_mynetworks="127.0.0.0/8, 192.168.1.2/32"
POSTFIX_smtpd_recipient_restrictions="check_recipient_access inline:{smtpd-recipient-restriction-contact@example.com=OK}, reject"
